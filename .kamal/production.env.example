# Copy to .kamal/production.env and restrict it before editing:
#   cp .kamal/production.env.example .kamal/production.env
#   chmod 600 .kamal/production.env
#
# bin/deploy reads that copy. It is gitignored. Do not commit real values.
# bin/deploy --import-secrets can fill a missing file from the running
# production container. An existing file is never overwritten.
#
# .kamal/secrets maps SECRET_KEY_BASE from RAILS_MASTER_KEY. Keep that mapping.
# Store the value currently injected as SECRET_KEY_BASE in RAILS_MASTER_KEY.
# Do not generate a new value here.
#
# Values are literal text after the first "=". They are not shell-expanded.
# KAMAL_REGISTRY_PASSWORD is optional: config/deploy.yml uses the local
# registry and does not reference a registry password.

RAILS_MASTER_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=
KAMAL_REGISTRY_PASSWORD=
